<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="?attr/colorBlackDialogFragment"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/root_layout"
        android:background="?attr/colorBgSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="0dp"
            android:layout_height="20dp"/>
        <su.happ.proxyutility.ui.foundation.component.HappTextView
            android:textSize="20sp"
            android:textColor="?attr/colorTextSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:text="@string/send_to_tv_text"
            android:textAlignment="center"
            android:layout_marginHorizontal="25dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="15dp"/>
        <su.happ.proxyutility.ui.foundation.component.button.HappTextButton
            android:textSize="18sp"
            android:textColor="?attr/colorTextDialog"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_button_transparent_borders_rounded_8"
            android:padding="@dimen/layout_margin_spacing_quaternary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:text="@string/send_to_tv_cancel"
            android:textAllCaps="false"
            android:layout_marginHorizontal="32dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="15dp"/>
        <su.happ.proxyutility.ui.foundation.component.button.HappTextButton
            android:enabled="false"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:id="@+id/btn_send"
            android:background="@drawable/bg_button_primary"
            android:padding="@dimen/layout_margin_spacing_quaternary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginRight="32dp"
            android:layout_marginBottom="30dp"
            android:text="@string/send_to_tv_confirm"
            android:textAllCaps="false"
            android:layout_marginHorizontal="32dp"/>
    </LinearLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="16dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_config_groups"
        android:paddingBottom="50dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>
