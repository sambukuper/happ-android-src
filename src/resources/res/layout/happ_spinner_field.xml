<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <su.happ.proxyutility.ui.foundation.component.HappTextView
            android:textSize="16sp"
            android:textColor="?attr/settingsText"
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_spinner_field"
            android:paddingTop="@dimen/layout_margin_spacing_secondary"
            android:paddingBottom="@dimen/layout_margin_spacing_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textIsSelectable="false"
            android:textAlignment="viewStart"
            android:layout_marginStart="@dimen/activity_horizontal_margin"
            android:layout_marginEnd="@dimen/layout_margin_spacing"
            android:paddingVertical="@dimen/layout_margin_spacing_secondary"/>
        <su.happ.proxyutility.ui.widget.CustomSpinner
            android:textSize="17sp"
            android:textColor="?attr/settingsListText"
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/spinner"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/layout_margin_spacing_secondary"
            android:paddingBottom="@dimen/layout_margin_spacing_secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dropdown"
            android:layout_marginStart="@dimen/layout_margin_spacing_extra_small"
            android:layout_marginEnd="@dimen/activity_horizontal_margin"
            android:paddingVertical="@dimen/layout_margin_spacing_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_fragmentation_type"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <su.happ.proxyutility.ui.foundation.component.HappTextView
        android:textSize="12sp"
        android:textColor="?attr/settingsTextDescription"
        android:gravity="center_vertical"
        android:id="@+id/tv_spinner_description"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginBottom="@dimen/layout_margin_spacing"
        android:textIsSelectable="false"
        android:layout_marginHorizontal="@dimen/activity_horizontal_margin"/>
</LinearLayout>
