<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/activity_vertical_margin"
    android:maxWidth="400dp"
    android:backgroundTint="@android:color/transparent"
    app:cardCornerRadius="@dimen/preference_radius"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_fragment_dialog_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <su.happ.proxyutility.ui.foundation.component.HappTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTitleDialog"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_margin_secondary"
            android:text="@string/test_title"
            android:textAlignment="center"/>
        <ScrollView
            android:id="@+id/sv_dns_tunnel"
            android:background="@drawable/bg_text_on_main"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:fillViewport="false"
            android:layout_weight="1"
            android:layout_marginVertical="6dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <su.happ.proxyutility.ui.foundation.component.HappTextView
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:gravity="bottom"
                    android:id="@+id/tv_dns_tunnel"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollbars="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="65536">
                    <requestFocus/>
                </su.happ.proxyutility.ui.foundation.component.HappTextView>
                <android.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="32dp"/>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cl_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dialog_fragment_horizontal_margin"
            android:layout_marginTop="16dp"
            android:layout_marginRight="@dimen/dialog_fragment_horizontal_margin"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="@dimen/dialog_fragment_horizontal_margin"
            android:layout_marginVertical="16dp">
            <su.happ.proxyutility.ui.foundation.component.button.HappTextButton
                android:textSize="18sp"
                android:textColor="@color/button_primary_foreground_on_background"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_reset"
                android:background="@drawable/bg_button_grey_state"
                android:padding="@dimen/layout_margin_spacing_quaternary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Reload"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                app:drawableTint="@null"/>
            <su.happ.proxyutility.ui.foundation.component.button.HappTextButton
                android:textSize="18sp"
                android:textColor="@color/button_primary_foreground_on_background"
                android:layout_gravity="center_vertical"
                android:id="@+id/btn_negative"
                android:background="@drawable/bg_button_grey_state"
                android:padding="@dimen/layout_margin_spacing_quaternary"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@android:string/cancel"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="6dp"
                app:drawableTint="@null"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
