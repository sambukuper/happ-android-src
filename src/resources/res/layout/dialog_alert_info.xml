<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="400dp"
    android:backgroundTint="@android:color/transparent"
    app:cardCornerRadius="@dimen/preference_radius"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_fragment_dialog_rounded"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <su.happ.proxyutility.ui.foundation.component.HappTextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTitleDialog"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <su.happ.proxyutility.ui.foundation.component.HappTextView
            android:textSize="16sp"
            android:textColor="?attr/colorTextDialog"
            android:id="@+id/tv_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dialog_margin_secondary"
            android:textAlignment="textStart"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <su.happ.proxyutility.ui.foundation.component.button.HappTextButton
            android:textSize="14sp"
            android:textColor="?attr/colorDialogTextButtonPositive"
            android:id="@+id/btn_positive"
            android:background="@drawable/bg_text_on_main_rounded"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
